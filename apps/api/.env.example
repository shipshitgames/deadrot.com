# Local API defaults. The API is safe to run without DATABASE_URL: `/health/live`
# returns ok, while `/health/ready` reports a clear degraded/missing database
# status. Set DATABASE_URL only when you intentionally want a real local DB.

HOST=127.0.0.1
PORT=3004
SERVICE_NAME=deadrot-api
ALLOWED_ORIGINS=http://127.0.0.1:3000,http://localhost:3000
CDN_ORIGIN=http://127.0.0.1:3000/assets
DATABASE_URL=
DATABASE_SSL_MODE=disable
