# Early-access paywall (epic #330). All optional: without BOTH Clerk keys the
# auth gate and sign-in UI no-op entirely (keyless CI/dev builds stay green).

# ── Clerk (create an application at dashboard.clerk.com) ─────────────────────
# RECOMMENDED dashboard setup beyond the keys (dashboard-only, no API for it):
#   Sessions → Customize session token →
#     { "deadrotCollection": "{{user.public_metadata.deadrotCollection}}" }
# proxy.ts reads the entitlement from that flat claim; without it the gate
# still works but does an authoritative Backend API lookup per gated request.
# The gate only engages when BOTH keys are present.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# Keep every Clerk flow on our own pages instead of the hosted Account Portal.
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# ── Warline authoritative report broker ─────────────────────────────────────
# Server-only. The browser POSTs finished operations to /api/warline/report with
# its Clerk session; this route attaches the PartyKit reporter identity. Never
# expose these values through NEXT_PUBLIC_* or VITE_* variables. The broker fails
# closed when any value is absent.
WARLINE_HOST=
WARLINE_REPORTER_ID=deadrot-web
WARLINE_REPORTER_TOKEN=

# ── Stripe (live product prod_UgEAC4hE4TFfoq "deadrot.com") ──────────────────
# Canonical origin for Stripe success/cancel URLs. Required in preview and
# production; it must be a clean HTTPS origin. Requests never supply this value.
# Local dev defaults narrowly to http://localhost:3000 when unset. Production:
# DEADROT_SITE_ORIGIN=https://deadrot.com
DEADROT_SITE_ORIGIN=
# Webhook endpoint — the trailing slash is LOAD-BEARING (trailingSlash:true
# 308-redirects the slashless URL and Stripe treats redirects as failures):
#   POST https://deadrot.com/api/stripe/webhook/
#   events: checkout.session.completed, checkout.session.async_payment_succeeded,
#           customer.subscription.created, customer.subscription.updated,
#           customer.subscription.deleted
# Local dev: stripe listen --forward-to localhost:3000/api/stripe/webhook/
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Defaults to the live $4.99 price (price_1Tgri8JLFu10NpzMceH1KZsS) when unset.
STRIPE_PRICE_ID=
# Customer-facing promo code pre-applied at checkout (so the discounted price
# shows without manual entry). Defaults to the early-buyer code FIRSTROT. The
# code is resolved to its Stripe promotion-code id at request time; once it
# expires or hits its redemption cap, checkout falls back to manual promo entry.
STRIPE_PROMO_CODE=

# ── Cross-property entitlement (shipshit.games Studio Pass → collection) ─────
# An active/trialing Studio Pass subscription on the SHARED Stripe account
# grants the Deadrot Collection here, bridged by the user's VERIFIED email
# (lib/shipshit-entitlement.ts). Qualifying subscriptions are matched by the
# price lookup_key "shipshit-studio-pass-49-usd-monthly" (the shipshit.games
# repo convention, stable across test/live) plus any product ids below.
# Test-mode Studio Pass product: prod_UexaLBrHgSA9KD. Add the live product id
# when the Studio Pass launches live (no other config change needed if the
# live price keeps the lookup key).
SHIPSHIT_STRIPE_PRODUCT_IDS=
# Kill switch: set to 1 to stop all cross-property grants AND revocations.
SHIPSHIT_ENTITLEMENT_DISABLED=

# ── Feature flags / dark-shipping (#384) ─────────────────────────────────────
# Vendor-agnostic flag layer (lib/flags.ts) for game visibility + dark-shipping,
# kept SEPARATE from the paywall above (a flag hides/reveals; it never grants
# access). All optional: with no key the layer no-ops to its defaults (every
# game visible), so CI/dev/keyless builds and e2e never depend on PostHog.
# PostHog is already a project dependency; these mirror the root VITE_POSTHOG_*.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
# Deterministic override / kill-switch (JSON map of flag→bool). Wins over the
# PostHog ramp; used for the edge kill-switch and tests. Flag-naming convention
# + the "delete the flag after rollout" habit: docs/feature-flags.md.
#   FLAG_OVERRIDES={"game-rothulk-visible":false}
FLAG_OVERRIDES=

# ── Access waitlist (#355) ───────────────────────────────────────────────────
# Production/preview success requires the first-party Deadrot API to commit the
# signup to Postgres. The token must match apps/api WAITLIST_INGEST_TOKEN.
WAITLIST_API_URL=https://api.deadrot.com/v1/waitlist
WAITLIST_API_TOKEN=
# Explicit local/E2E-only fallback: fsynced JSONL persistence. Rejected whenever
# NODE_ENV=production or VERCEL_ENV is preview/production. Prefer the local API
# for real development; Playwright config supplies its own temp-file path.
WAITLIST_LOCAL_FILE=
