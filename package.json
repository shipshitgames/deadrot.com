{
  "name": "deadrotcom",
  "version": "0.0.0",
  "private": true,
  "packageManager": "bun@1.3.14",
  "workspaces": [
    "apps/*",
    "apps/games/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "demo:dev": "node scripts/demo-stack.mjs",
    "demo:smoke": "node scripts/demo-smoke.mjs",
    "build": "turbo run build",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "lint:react": "react-doctor -y --project web,brawl,deadlane,pactfall,redline,rothulk,scourge-survivors,starblight,warline,@shipshitgames/ui --no-score --no-telemetry",
    "lint:packages": "turbo run lint",
    "test": "bun run test:unit && bun run test:e2e:unit",
    "test:unit": "turbo run test:unit",
    "test:e2e:unit": "bun test e2e/*.test.ts",
    "test:coverage": "turbo run test:coverage --filter=@deadrot/catalog --filter=@deadrot/game-kit --filter=@shipshitgames/warline",
    "test:coverage:all": "turbo run test:coverage",
    "e2e": "bun run test:e2e",
    "test:e2e": "playwright install chromium && playwright test",
    "test:e2e:web": "playwright install chromium && playwright test -c apps/web/playwright.config.ts",
    "test:e2e:workspaces": "turbo run test:e2e",
    "proof:tours": "playwright install chromium && node scripts/run-proof-tours.mjs",
    "e2e:docker": "scripts/run-e2e-docker.sh",
    "e2e:ui": "playwright test --ui",
    "e2e:report": "playwright show-report",
    "social:check": "node scripts/check-social-metadata.mjs",
    "codex:check": "bun test packages/assets/tests/lore-drift.test.ts packages/game-kit/tests/codex.test.ts apps/web/tests/unit/codex.test.ts",
    "check:secrets": "node scripts/check-secrets.mjs",
    "assets:check": "node scripts/check-assets.mjs && bun run --cwd packages/assets assets:budgets --check",
    "assets:budgets": "bun run --cwd packages/assets assets:budgets",
    "board:hygiene": "node scripts/board-hygiene.mjs",
    "deploy:games:changed": "node scripts/deploy-changed-games.mjs",
    "sentry:upload-vite-sourcemaps": "node scripts/sentry-upload-vite-sourcemaps.mjs",
    "telemetry:check-env": "node scripts/check-telemetry-env.mjs",
    "typecheck": "turbo run typecheck",
    "ci": "bun run check && bun run typecheck && bun run social:check && bun run assets:check",
    "deps:update": "bunx npm-check-updates -u --deep --cooldown 3h --removeRange && bun install",
    "doctor": "react-doctor -y --project web,brawl,deadlane,pactfall,redline,rothulk,scourge-survivors,starblight,warline,@shipshitgames/ui --no-score --no-telemetry",
    "prepare": "git config core.hooksPath .githooks || true"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.16",
    "@deadrot/catalog": "workspace:*",
    "@playwright/test": "^1.60.0",
    "react-doctor": "^0.4.0",
    "turbo": "2.9.16",
    "typescript": "6.0.3"
  }
}
